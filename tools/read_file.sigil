// read_file.sigil — dispatched tool: read a sandbox file.
// INPUT: the path. OUTPUT: file bytes, or negative errno (-403 outside
// the fs grant — FROM THE LANGUAGE). MANIFEST: fs: [sandbox] only.
// AUTHORSHIP: v14 via the workbench (greedy, oracle-verified). Human
// fix: tool_main signature i64->i32 (the outer-ring param rule the task
// text omitted; see docs/style.md).
#[ring(outer)] #[trusted] module tool;

extern "C" fn fs_read(path: i32, path_len: i32) -> i64 ! { FFI, Unsafe };

pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { FsIO, Alloc, FFI, Unsafe } {
    let raw: i64 @Internal = fs_read(input_ptr, input_len);
    if raw < 0 {
        return raw;
    } else {
        let file_ptr: i64 @Internal = raw / 4294967296;
        let file_len: i64 @Internal = raw - file_ptr * 4294967296;
        let out: i64 @Internal = alloc(file_len);
        let mut i: i64 @Internal = 0;
        while i < file_len {
            let b: i64 @Internal = load8(file_ptr + i);
            store8(out + i, b);
            i = i + 1;
        }
        return out * 4294967296 + file_len;
    }
}
