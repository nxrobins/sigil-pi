// grep_file.sigil — dispatched tool: return the lines of a file matching a substring.
// INPUT: '<path>|<pattern>' (first pipe splits; pattern is the last segment so it
// may contain pipes). OUTPUT: the matching lines, newline-joined (no trailing
// newline), or negative errno (-400 malformed, -403 outside the fs grant).
// MANIFEST: fs: [sandbox] only.
// AUTHORSHIP: v14 via the workbench (sample 1/4, T=0.7). Human fix 1: the emit
// logic put a newline AFTER each match (trailing-newline off-by-one); changed
// to a separator BETWEEN matches. Human fix 2 (S2 audit): the original matcher
// was a single streaming pass that, on a mismatch, reset the match counter to
// at most 1 — it could not back up into the partial match it had already
// consumed. Any pattern whose prefix overlaps itself was therefore missed
// ('aab' in 'aaab', 'nano' in 'nanano', 'issip' in 'mississippi' all returned
// NO match). Replaced with an explicit per-offset search (`line_contains`):
// correct by construction, and it cannot silently under-report. See
// docs/style.md.
#[ring(outer)] #[trusted] module tool;

extern "C" fn fs_read(path: i32, path_len: i32) -> i64 ! { FFI, Unsafe };

fn append_segment(
    out_ptr: i64 @Internal,
    out_len_in: i64 @Internal,
    file_ptr: i64 @Internal,
    start: i64 @Internal,
    end: i64 @Internal,
) -> i64 @Internal ! {} {
    let mut out_len: i64 @Internal = out_len_in;
    let mut i: i64 @Internal = start;

    while i < end {
        let b: i64 @Internal = load8(file_ptr + i);
        store8(out_ptr + out_len, b);
        out_len = out_len + 1;
        i = i + 1;
    }

    return out_len;
}

// Does [line_start, line_end) contain the pattern? Tries EVERY start offset,
// so an overlapping prefix (the bug this replaced) can never hide a match.
// O(line * pattern); the fuel bound is the backstop on pathological input.
fn line_contains(
    file_ptr: i64 @Internal,
    line_start: i64 @Internal,
    line_end: i64 @Internal,
    pat_ptr: i64 @Internal,
    pat_len: i64 @Internal,
) -> i64 @Internal ! {} {
    let mut start: i64 @Internal = line_start;
    let mut found: i64 @Internal = 0;

    while start + pat_len <= line_end {
        if found == 0 {
            let mut k: i64 @Internal = 0;
            let mut ok: i64 @Internal = 1;
            while k < pat_len {
                if ok == 1 {
                    let a: i64 @Internal = load8(file_ptr + start + k);
                    let p: i64 @Internal = load8(pat_ptr + k);
                    if a == p {
                    } else {
                        ok = 0;
                    }
                } else {
                }
                k = k + 1;
            }
            if ok == 1 {
                found = 1;
            } else {
            }
        } else {
        }
        start = start + 1;
    }

    return found;
}

pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { FsIO, Alloc, FFI, Unsafe } {
    let zero_i32: i32 = input_len - input_len;
    let one_i32: i32 = input_len / input_len;

    let mut split: i32 = input_len;
    let mut scan: i32 = zero_i32;
    while scan < input_len {
        let b: i64 @Internal = load8(input_ptr + scan);
        if split == input_len {
            if b == 124 {
                split = scan;
            } else {
            }
        } else {
        }
        scan = scan + one_i32;
    }

    if split == input_len {
        return 0 - 400;
    } else {
        let raw: i64 @Internal = fs_read(input_ptr, split);

        if raw < 0 {
            return raw;
        } else {
            let pat_start: i32 @Internal = split + one_i32;
            let pat_len_i32: i32 @Internal = input_len - pat_start;
            let pat_len: i64 @Internal = pat_len_i32.as_i64();

            if pat_len == 0 {
                return 0 - 400;
            } else {
                let pat_base: i64 @Internal = input_ptr.as_i64();
                let pat_off: i64 @Internal = pat_start.as_i64();
                let pat_src: i64 @Internal = pat_base + pat_off;
                let pat_ptr: i64 @Internal = alloc(pat_len);
                let mut c: i64 @Internal = 0;
                while c < pat_len {
                    let pb: i64 @Internal = load8(pat_src + c);
                    store8(pat_ptr + c, pb);
                    c = c + 1;
                }

                let file_ptr: i64 @Internal = raw / 4294967296;
                let file_len: i64 @Internal = raw - file_ptr * 4294967296;

                // Matched lines joined by '\n' are never longer than the file
                // itself (each emitted line drops its own terminator).
                let out_ptr: i64 @Internal = alloc(file_len);
                let mut out_len: i64 @Internal = 0;
                let mut line_start: i64 @Internal = 0;
                let mut i: i64 @Internal = 0;

                while i < file_len {
                    let b: i64 @Internal = load8(file_ptr + i);
                    if b == 10 {
                        if line_contains(file_ptr, line_start, i, pat_ptr, pat_len) == 1 {
                            if out_len > 0 {
                                store8(out_ptr + out_len, 10);
                                out_len = out_len + 1;
                            } else {
                            }
                            out_len = append_segment(out_ptr, out_len, file_ptr, line_start, i);
                        } else {
                        }
                        line_start = i + 1;
                    } else {
                    }
                    i = i + 1;
                }

                // Trailing line with no final newline.
                if line_start < file_len {
                    if line_contains(file_ptr, line_start, file_len, pat_ptr, pat_len) == 1 {
                        if out_len > 0 {
                            store8(out_ptr + out_len, 10);
                            out_len = out_len + 1;
                        } else {
                        }
                        out_len = append_segment(out_ptr, out_len, file_ptr, line_start, file_len);
                    } else {
                    }
                } else {
                }

                return out_ptr * 4294967296 + out_len;
            }
        }
    }
}
