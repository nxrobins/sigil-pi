// grep_tree.sigil — dispatched tool: search every file under a directory.
// INPUT: '<path>|<pattern>' (first pipe splits; pattern is the last segment so
// it may contain pipes). OUTPUT: for every file in sorted depth-first order,
// every line containing the pattern, as 'relpath:lineno: line' (grep -n
// shaped), newline-joined, no trailing newline. Errors: -400 malformed/empty
// pattern, -403 outside the fs grant, -404 path missing/not-a-dir, -413
// output over the in-guest cap, -508 deeper than 64 levels.
// Directories are detected by probing fs_list (>=0 dir, -404 file), the same
// contract as list_tree; the per-line matcher is grep_file's per-offset
// search, which cannot miss an overlapping-prefix match.
// MANIFEST: fs: [sandbox] only.
// AUTHORSHIP: hand-authored (Claude, this repo) against docs/style.md and the
// existing v14 tools as idiom reference; walk pattern shared with
// list_tree.sigil (probe-verified recursion). Not v14.
#[ring(outer)] #[trusted] module tool;

extern "C" fn fs_list(path: i32, path_len: i32) -> i64 ! { FFI, Unsafe };
extern "C" fn fs_read(path: i32, path_len: i32) -> i64 ! { FFI, Unsafe };

fn emit_bytes(
    out_ptr: i64 @Internal,
    out_len_in: i64 @Internal,
    src_ptr: i64 @Internal,
    start: i64 @Internal,
    end: i64 @Internal,
) -> i64 @Internal ! {} {
    let mut out_len: i64 @Internal = out_len_in;
    let mut i: i64 @Internal = start;
    while i < end {
        let b: i64 @Internal = load8(src_ptr + i);
        store8(out_ptr + out_len, b);
        out_len = out_len + 1;
        i = i + 1;
    }
    return out_len;
}

// Decimal render of value (>= 1) after out_len bytes of out; new out_len.
fn emit_decimal(
    out_ptr: i64 @Internal,
    out_len_in: i64 @Internal,
    value_in: i64 @Internal,
) -> i64 @Internal ! { Alloc } {
    let mut out_len: i64 @Internal = out_len_in;
    let tmp: i64 @Internal = alloc(20);
    let mut v: i64 @Internal = value_in;
    let mut n: i64 @Internal = 0;
    while v > 0 {
        let digit: i64 @Internal = v - (v / 10) * 10;
        store8(tmp + n, 48 + digit);
        v = v / 10;
        n = n + 1;
    }
    while n > 0 {
        n = n - 1;
        let d: i64 @Internal = load8(tmp + n);
        store8(out_ptr + out_len, d);
        out_len = out_len + 1;
    }
    return out_len;
}

// Does [line_start, line_end) contain the pattern? Per-offset search — an
// overlapping prefix can never hide a match (grep_file's matcher).
fn line_contains(
    file_ptr: i64 @Internal,
    line_start: i64 @Internal,
    line_end: i64 @Internal,
    pat_ptr: i64 @Internal,
    pat_len: i64 @Internal,
) -> i64 @Internal ! {} {
    let mut start: i64 @Internal = line_start;
    let mut found: i64 @Internal = 0;
    while start + pat_len <= line_end {
        if found == 0 {
            let mut k: i64 @Internal = 0;
            let mut ok: i64 @Internal = 1;
            while k < pat_len {
                if ok == 1 {
                    let a: i64 @Internal = load8(file_ptr + start + k);
                    let p: i64 @Internal = load8(pat_ptr + k);
                    if a == p {
                    } else {
                        ok = 0;
                    }
                } else {
                }
                k = k + 1;
            }
            if ok == 1 {
                found = 1;
            } else {
            }
        } else {
        }
        start = start + 1;
    }
    return found;
}

// Emit every matching line of ONE file as 'rel:lineno: line\n'. The file's
// absolute path is [path_ptr, path_len); its root-relative part starts at
// root_len + 1. Returns the new out_len, or a negative errno.
fn grep_one_file(
    root_len: i64 @Internal,
    path_ptr: i64 @Internal,
    path_len: i64 @Internal,
    pat_ptr: i64 @Internal,
    pat_len: i64 @Internal,
    out_ptr: i64 @Internal,
    out_len_in: i64 @Internal,
) -> i64 @Internal ! { FsIO, Alloc, FFI, Unsafe } {
    let raw: i64 @Internal = fs_read(path_ptr.as_i32(), path_len.as_i32());
    if raw < 0 {
        return raw;
    } else {
    }
    let file_ptr: i64 @Internal = raw / 4294967296;
    let file_len: i64 @Internal = raw - file_ptr * 4294967296;

    let rel_start: i64 @Internal = root_len + 1;
    let rel_len: i64 @Internal = path_len - rel_start;

    let mut out_len: i64 @Internal = out_len_in;
    let mut line_no: i64 @Internal = 1;
    let mut line_start: i64 @Internal = 0;
    let mut i: i64 @Internal = 0;
    while i <= file_len {
        let mut at_end: i64 @Internal = 0;
        if i == file_len {
            if line_start < file_len {
                at_end = 1;
            } else {
            }
        } else {
            let b: i64 @Internal = load8(file_ptr + i);
            if b == 10 {
                at_end = 1;
            } else {
            }
        }
        if at_end == 1 {
            if line_contains(file_ptr, line_start, i, pat_ptr, pat_len) == 1 {
                // 'rel' ':' digits ':' ' ' line '\n'  (digits <= 20)
                let line_len: i64 @Internal = i - line_start;
                if out_len + rel_len + line_len + 24 > 4194304 {
                    return 0 - 413;
                } else {
                }
                out_len = emit_bytes(out_ptr, out_len, path_ptr, rel_start, path_len);
                store8(out_ptr + out_len, 58);
                out_len = out_len + 1;
                out_len = emit_decimal(out_ptr, out_len, line_no);
                store8(out_ptr + out_len, 58);
                store8(out_ptr + out_len + 1, 32);
                out_len = out_len + 2;
                out_len = emit_bytes(out_ptr, out_len, file_ptr, line_start, i);
                store8(out_ptr + out_len, 10);
                out_len = out_len + 1;
            } else {
            }
            line_start = i + 1;
            line_no = line_no + 1;
        } else {
        }
        i = i + 1;
    }
    return out_len;
}

// Walk one directory; grep every file under it. Same walk as list_tree.
fn walk(
    root_len: i64 @Internal,
    dir_ptr: i64 @Internal,
    dir_len: i64 @Internal,
    pat_ptr: i64 @Internal,
    pat_len: i64 @Internal,
    out_ptr: i64 @Internal,
    out_len_in: i64 @Internal,
    depth: i64 @Internal,
) -> i64 @Internal ! { FsIO, Alloc, FFI, Unsafe } {
    if depth > 64 {
        return 0 - 508;
    } else {
    }
    let neg404: i64 @Internal = 0 - 404;

    let listing: i64 @Internal = fs_list(dir_ptr.as_i32(), dir_len.as_i32());
    if listing < 0 {
        return listing;
    } else {
    }
    let names_ptr: i64 @Internal = listing / 4294967296;
    let names_len: i64 @Internal = listing - names_ptr * 4294967296;

    let mut out_len: i64 @Internal = out_len_in;
    let mut name_start: i64 @Internal = 0;
    let mut i: i64 @Internal = 0;
    while i <= names_len {
        let mut at_sep: i64 @Internal = 0;
        if i == names_len {
            at_sep = 1;
        } else {
            let b: i64 @Internal = load8(names_ptr + i);
            if b == 10 {
                at_sep = 1;
            } else {
            }
        }
        if at_sep == 1 {
            let name_len: i64 @Internal = i - name_start;
            if name_len > 0 {
                let child_len: i64 @Internal = dir_len + 1 + name_len;
                let child: i64 @Internal = alloc(child_len);
                let mut c: i64 @Internal = 0;
                while c < dir_len {
                    let db: i64 @Internal = load8(dir_ptr + c);
                    store8(child + c, db);
                    c = c + 1;
                }
                store8(child + dir_len, 47);
                let mut n: i64 @Internal = 0;
                while n < name_len {
                    let nb: i64 @Internal = load8(names_ptr + name_start + n);
                    store8(child + dir_len + 1 + n, nb);
                    n = n + 1;
                }

                let probe: i64 @Internal = fs_list(child.as_i32(), child_len.as_i32());
                if probe < 0 {
                    if probe == neg404 {
                        let grepped: i64 @Internal = grep_one_file(
                            root_len, child, child_len, pat_ptr, pat_len, out_ptr, out_len);
                        if grepped < 0 {
                            return grepped;
                        } else {
                        }
                        out_len = grepped;
                    } else {
                        return probe;
                    }
                } else {
                    let walked: i64 @Internal = walk(
                        root_len, child, child_len, pat_ptr, pat_len, out_ptr, out_len, depth + 1);
                    if walked < 0 {
                        return walked;
                    } else {
                    }
                    out_len = walked;
                }
            } else {
            }
            name_start = i + 1;
        } else {
        }
        i = i + 1;
    }
    return out_len;
}

pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { FsIO, Alloc, FFI, Unsafe } {
    let zero_i32: i32 = input_len - input_len;
    let one_i32: i32 = input_len / input_len;

    let mut split: i32 = input_len;
    let mut scan: i32 = zero_i32;
    while scan < input_len {
        let b: i64 @Internal = load8(input_ptr + scan);
        if split == input_len {
            if b == 124 {
                split = scan;
            } else {
            }
        } else {
        }
        scan = scan + one_i32;
    }
    if split == input_len {
        return 0 - 400;
    } else {
    }

    let base: i64 @Internal = input_ptr.as_i64();
    let root_len: i64 @Internal = split.as_i64();
    let pat_start: i64 @Internal = root_len + 1;
    let pat_len: i64 @Internal = input_len.as_i64() - pat_start;
    if pat_len == 0 {
        return 0 - 400;
    } else {
    }
    let pat_ptr: i64 @Internal = base + pat_start;

    let out_ptr: i64 @Internal = alloc(4194304);
    let r: i64 @Internal = walk(root_len, base, root_len, pat_ptr, pat_len, out_ptr, 0, 0);
    if r < 0 {
        return r;
    } else {
    }
    if r > 0 {
        return out_ptr * 4294967296 + r - 1;
    } else {
        return out_ptr * 4294967296;
    }
}
