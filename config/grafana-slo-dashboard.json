{
  "__inputs": [
    {
      "description": "Prometheus collector scraping the authenticated sigil-pi endpoint",
      "label": "Prometheus",
      "name": "DS_PROMETHEUS",
      "pluginId": "prometheus",
      "pluginName": "Prometheus",
      "type": "datasource"
    }
  ],
  "annotations": {"list": []},
  "description": "Launch SLO and resource signals for the supported one-worker sigil-pi v1 topology.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Aggregate readiness plus each bounded runtime, state, quota, schedule, audit, and retention component.",
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [
        {"expr": "min(sigil_pi_dependency_ready)", "legendFormat": "aggregate", "refId": "A"},
        {"expr": "min by (dependency) (sigil_pi_dependency_component_ready)", "legendFormat": "{{dependency}}", "refId": "B"}
      ],
      "title": "Dependency readiness",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Service-generated 5xx responses must stay below 0.5%.",
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 0.01, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.005}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 5, "x": 4, "y": 0},
      "id": 2,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "sum(rate(sigil_pi_http_requests_total{status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(sigil_pi_http_requests_total[$__rate_interval])), 1e-9)", "refId": "A"}],
      "title": "Service 5xx ratio",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Pilot target: at least 99.5% completed turns are successful.",
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0.99, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.995}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 5, "x": 9, "y": 0},
      "id": 3,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "1 - (sum(rate(sigil_pi_turn_errors_total[$__rate_interval])) / clamp_min(sum(rate(sigil_pi_turns_total[$__rate_interval])), 1e-9))", "refId": "A"}],
      "title": "Successful turns",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Free disk must remain above the 20% launch bound.",
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.2}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 5, "x": 14, "y": 0},
      "id": 4,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "sum(sigil_pi_disk_free_bytes) / clamp_min(sum(sigil_pi_disk_total_bytes), 1)", "refId": "A"}],
      "title": "Disk free ratio",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Both automatic lifecycle monitors must remain healthy.",
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 5, "x": 19, "y": 0},
      "id": 5,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "name"},
      "targets": [
        {"expr": "min(sigil_pi_audit_verification_healthy)", "legendFormat": "audit", "refId": "A"},
        {"expr": "min(sigil_pi_retention_healthy)", "legendFormat": "retention", "refId": "B"}
      ],
      "title": "Lifecycle integrity",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "End-to-end completed-turn latency percentiles; the load report remains authoritative for traffic-profile separation.",
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "id": 6,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(sigil_pi_turn_duration_ms_bucket[$__rate_interval])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(sigil_pi_turn_duration_ms_bucket[$__rate_interval])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(sigil_pi_turn_duration_ms_bucket[$__rate_interval])))", "legendFormat": "p99", "refId": "C"}
      ],
      "title": "Turn latency",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Qualification target: p95 queue wait below 2,000 ms.",
      "fieldConfig": {"defaults": {"unit": "ms", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 2000}]}}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "id": 7,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(sigil_pi_queue_wait_ms_bucket[$__rate_interval])))", "legendFormat": "p95", "refId": "A"}],
      "title": "Queue wait",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Concurrent work and bounded provider/tool activity.",
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "id": 8,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum(sigil_pi_active_turns)", "legendFormat": "active turns", "refId": "A"},
        {"expr": "sum(rate(sigil_pi_retries_total[$__rate_interval]))", "legendFormat": "retries/s", "refId": "B"},
        {"expr": "sum(rate(sigil_pi_tool_calls_total[$__rate_interval]))", "legendFormat": "tools/s", "refId": "C"},
        {"expr": "sum(rate(sigil_pi_input_tokens_total[$__rate_interval]) + rate(sigil_pi_output_tokens_total[$__rate_interval]))", "legendFormat": "tokens/s", "refId": "D"}
      ],
      "title": "Turn activity",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Process and durable-state envelope signals.",
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "id": 9,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum(sigil_pi_memory_peak_bytes)", "legendFormat": "memory peak", "refId": "A"},
        {"expr": "sum(sigil_pi_state_storage_bytes)", "legendFormat": "state", "refId": "B"},
        {"expr": "sum(sigil_pi_audit_storage_bytes)", "legendFormat": "audit", "refId": "C"},
        {"expr": "sum(sigil_pi_sandbox_storage_bytes)", "legendFormat": "sandboxes", "refId": "D"}
      ],
      "title": "Resource consumption",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["sigil-pi", "slo", "v1"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "sigil-pi v1 SLO",
  "uid": "sigil-pi-v1-slo",
  "version": 1,
  "weekStart": ""
}
