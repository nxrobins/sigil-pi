// gl_fetch.sigil — pipeline stage 1 of gl_issues: POST a GraphQL query for a
// GitLab project's open issues.
// INPUT: '<endpoint>|<group/project>' (first pipe splits; the endpoint is a
// manifest bound_arg, never model-chosen). The path is WHITELIST-validated:
// at least one '/', no empty segment, bytes limited to [A-Za-z0-9_.-/].
// GitLab nests, so 'group/subgroup/project' is legal — unlike GitHub's exactly
// -one-slash rule. Validation rather than escaping is the point: the path is
// interpolated into a GraphQL STRING literal, and a path that cannot contain a
// quote or a backslash cannot break out of it.
// OUTPUT: the response body verbatim (stage 2, gl_shape.sigil, digests it), or
// negative errno: -400 malformed input/path, -403 host not in the net grant OR
// the {{secret:gitlab}} placeholder ungranted (no token configured — the
// request is never sent), -502 transport.
// MANIFEST: net: [gitlab.com] + secret: [{SECRET:gitlab}].
//
// WHY GRAPHQL AND NOT THE REST API: at the pinned toolchain the ONLY shim that
// carries a host-injected secret is `http_post_secret` — there is no
// `http_get_secret`. GitLab's REST issues endpoint is a GET, so authenticating
// it would mean either putting the token in the guest (defeating M5a) or in a
// query string. Its GraphQL endpoint is a POST, so the proven secret path
// applies unchanged. See docs/style.md.
//
// THE TOKEN IS NEVER IN THIS GUEST (M5a). The header blob carries the
// PLACEHOLDER; the host substitutes the real token inside the shim, after this
// program can no longer touch it.
// AUTHORSHIP: hand-authored (Claude, this repo) against docs/style.md; the
// GraphQL body assembly and secret-header discipline follow gh_fetch.sigil.
// Not v14.
#[ring(outer)] #[trusted] module tool;

extern "C" fn http_post_secret(
    url: i32, url_len: i32,
    body: i32, body_len: i32,
    hdrs: i32, hdrs_len: i32
) -> i64 ! { FFI, Unsafe };

pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { NetIO, Alloc, FFI, Unsafe } {
    let zero_i32: i32 = input_len - input_len;
    if input_len == zero_i32 {
        return 0 - 400;
    } else {
    }
    let one_i32: i32 = input_len / input_len;

    let mut sep32: i32 = input_len;
    let mut scan: i32 = zero_i32;
    while scan < input_len {
        let b: i64 @Internal = load8(input_ptr + scan);
        if b == 124 {
            if sep32 == input_len {
                sep32 = scan;
            } else {
            }
        } else {
        }
        scan = scan + one_i32;
    }
    if sep32 == input_len {
        return 0 - 400;
    } else {
    }

    let path_start_i32: i32 @Internal = sep32 + one_i32;
    if path_start_i32 == input_len {
        return 0 - 400;
    } else {
    }

    // Whitelist, count slashes, and reject empty segments ('a//b', '/a', 'a/').
    let mut slashes: i64 @Internal = 0;
    let mut prev_slash: i64 @Internal = 1;   // a leading '/' means an empty first segment
    let mut v: i32 @Internal = path_start_i32;
    while v < input_len {
        let b: i64 @Internal = load8(input_ptr + v);
        let mut ok: i64 @Internal = 0;
        if b >= 97 {
            if b <= 122 {
                ok = 1;
            } else {
            }
        } else {
        }
        if b >= 65 {
            if b <= 90 {
                ok = 1;
            } else {
            }
        } else {
        }
        if b >= 48 {
            if b <= 57 {
                ok = 1;
            } else {
            }
        } else {
        }
        if b == 45 {
            ok = 1;
        } else {
        }
        if b == 95 {
            ok = 1;
        } else {
        }
        if b == 46 {
            ok = 1;
        } else {
        }
        if b == 47 {
            if prev_slash == 1 {
                return 0 - 400;
            } else {
            }
            ok = 1;
            slashes = slashes + 1;
            prev_slash = 1;
        } else {
            prev_slash = 0;
        }
        if ok == 0 {
            return 0 - 400;
        } else {
        }
        v = v + one_i32;
    }
    if slashes == 0 {
        return 0 - 400;
    } else {
    }
    if prev_slash == 1 {          // trailing '/' => empty last segment
        return 0 - 400;
    } else {
    }

    let path_src: i64 @Internal = input_ptr.as_i64() + path_start_i32.as_i64();
    let path_len: i64 @Internal = input_len.as_i64() - path_start_i32.as_i64();

    // {"query":"query{project(fullPath:\"P\"){issues(state:opened,first:15){count nodes{iid title userNotesCount}}}}"}
    let body_len: i64 @Internal = 41 + path_len + 92;
    let body: i64 @Internal = alloc(body_len);
    let mut o: i64 @Internal = 0;

    // part A: {"query":"query{project(fullPath:\\\"
    let a: i64 @Internal = alloc(48);
    store8(a + 0, 123);  store8(a + 1, 34);   store8(a + 2, 113);
    store8(a + 3, 117);  store8(a + 4, 101);  store8(a + 5, 114);
    store8(a + 6, 121);  store8(a + 7, 34);   store8(a + 8, 58);
    store8(a + 9, 34);   store8(a + 10, 113); store8(a + 11, 117);
    store8(a + 12, 101); store8(a + 13, 114); store8(a + 14, 121);
    store8(a + 15, 123); store8(a + 16, 112); store8(a + 17, 114);
    store8(a + 18, 111); store8(a + 19, 106); store8(a + 20, 101);
    store8(a + 21, 99);  store8(a + 22, 116); store8(a + 23, 40);
    store8(a + 24, 102); store8(a + 25, 117); store8(a + 26, 108);
    store8(a + 27, 108); store8(a + 28, 80);  store8(a + 29, 97);
    store8(a + 30, 116); store8(a + 31, 104); store8(a + 32, 58);
    store8(a + 33, 92);  store8(a + 34, 92);  store8(a + 35, 92);
    store8(a + 36, 34);
    let mut i: i64 @Internal = 0;
    while i < 37 {
        store8(body + o, load8(a + i));
        o = o + 1;
        i = i + 1;
    }
    let mut k: i64 @Internal = 0;
    while k < path_len {
        store8(body + o, load8(path_src + k));
        o = o + 1;
        k = k + 1;
    }
    // part B: \\\"){issues(state:opened,first:15){count nodes{iid title userNotesCount}}}}"}
    let c: i64 @Internal = alloc(128);
    store8(c + 0, 92);   store8(c + 1, 92);   store8(c + 2, 92);
    store8(c + 3, 34);   store8(c + 4, 41);   store8(c + 5, 123);
    store8(c + 6, 105);  store8(c + 7, 115);  store8(c + 8, 115);
    store8(c + 9, 117);  store8(c + 10, 101); store8(c + 11, 115);
    store8(c + 12, 40);  store8(c + 13, 115); store8(c + 14, 116);
    store8(c + 15, 97);  store8(c + 16, 116); store8(c + 17, 101);
    store8(c + 18, 58);  store8(c + 19, 111); store8(c + 20, 112);
    store8(c + 21, 101); store8(c + 22, 110); store8(c + 23, 101);
    store8(c + 24, 100); store8(c + 25, 44);  store8(c + 26, 102);
    store8(c + 27, 105); store8(c + 28, 114); store8(c + 29, 115);
    store8(c + 30, 116); store8(c + 31, 58);  store8(c + 32, 49);
    store8(c + 33, 53);  store8(c + 34, 41);  store8(c + 35, 123);
    store8(c + 36, 99);  store8(c + 37, 111); store8(c + 38, 117);
    store8(c + 39, 110); store8(c + 40, 116); store8(c + 41, 32);
    store8(c + 42, 110); store8(c + 43, 111); store8(c + 44, 100);
    store8(c + 45, 101); store8(c + 46, 115); store8(c + 47, 123);
    store8(c + 48, 105); store8(c + 49, 105); store8(c + 50, 100);
    store8(c + 51, 32);  store8(c + 52, 116); store8(c + 53, 105);
    store8(c + 54, 116); store8(c + 55, 108); store8(c + 56, 101);
    store8(c + 57, 32);  store8(c + 58, 117); store8(c + 59, 115);
    store8(c + 60, 101); store8(c + 61, 114); store8(c + 62, 78);
    store8(c + 63, 111); store8(c + 64, 116); store8(c + 65, 101);
    store8(c + 66, 115); store8(c + 67, 67);  store8(c + 68, 111);
    store8(c + 69, 117); store8(c + 70, 110); store8(c + 71, 116);
    store8(c + 72, 125); store8(c + 73, 125); store8(c + 74, 125);
    store8(c + 75, 125); store8(c + 76, 34);  store8(c + 77, 125);
    i = 0;
    while i < 78 {
        store8(body + o, load8(c + i));
        o = o + 1;
        i = i + 1;
    }

    // authorization: bearer {{secret:gitlab}}\ncontent-type: application/json
    let h: i64 @Internal = alloc(128);
    store8(h + 0, 97);   store8(h + 1, 117);  store8(h + 2, 116);
    store8(h + 3, 104);  store8(h + 4, 111);  store8(h + 5, 114);
    store8(h + 6, 105);  store8(h + 7, 122);  store8(h + 8, 97);
    store8(h + 9, 116);  store8(h + 10, 105); store8(h + 11, 111);
    store8(h + 12, 110); store8(h + 13, 58);  store8(h + 14, 32);
    store8(h + 15, 98);  store8(h + 16, 101); store8(h + 17, 97);
    store8(h + 18, 114); store8(h + 19, 101); store8(h + 20, 114);
    store8(h + 21, 32);  store8(h + 22, 123); store8(h + 23, 123);
    store8(h + 24, 115); store8(h + 25, 101); store8(h + 26, 99);
    store8(h + 27, 114); store8(h + 28, 101); store8(h + 29, 116);
    store8(h + 30, 58);  store8(h + 31, 103); store8(h + 32, 105);
    store8(h + 33, 116); store8(h + 34, 108); store8(h + 35, 97);
    store8(h + 36, 98);  store8(h + 37, 125); store8(h + 38, 125);
    store8(h + 39, 10);
    store8(h + 40, 99);  store8(h + 41, 111); store8(h + 42, 110);
    store8(h + 43, 116); store8(h + 44, 101); store8(h + 45, 110);
    store8(h + 46, 116); store8(h + 47, 45);  store8(h + 48, 116);
    store8(h + 49, 121); store8(h + 50, 112); store8(h + 51, 101);
    store8(h + 52, 58);  store8(h + 53, 32);  store8(h + 54, 97);
    store8(h + 55, 112); store8(h + 56, 112); store8(h + 57, 108);
    store8(h + 58, 105); store8(h + 59, 99);  store8(h + 60, 97);
    store8(h + 61, 116); store8(h + 62, 105); store8(h + 63, 111);
    store8(h + 64, 110); store8(h + 65, 47);  store8(h + 66, 106);
    store8(h + 67, 115); store8(h + 68, 111); store8(h + 69, 110);

    return http_post_secret(input_ptr, sep32,
                            body.as_i32(), o.as_i32(),
                            h.as_i32(), 70);
}
