// Source of truth: tools/frag_main.sigil + tools/frag_helpers.sigil
// (composed with stdlib http + kv so sigil-serve can compile it directly).
// Phase 5a-3: stdlib `http` module — HTTP GET/POST.
//
// Tools that `use sigil::http;` MUST declare `#[ring(outer)] #[trusted]`
// (per R004) and supply `NetGrant`s naming the host patterns they need
// to reach. Without a matching grant, GET/POST return -403.
//
// Response body cap: 5 MB. Beyond that, returns -413.
#[ring(outer)] #[trusted] module http;

effect NetIO;

extern "C" fn http_get(url: i32, url_len: i32) -> i64 ! { FFI, Unsafe };
extern "C" fn http_post(url: i32, url_len: i32, body: i32, body_len: i32) -> i64 ! { FFI, Unsafe };
extern "C" fn http_post_hdrs(url: i32, url_len: i32, body: i32, body_len: i32, hdrs: i32, hdrs_len: i32) -> i64 ! { FFI, Unsafe };

// HTTP GET. Returns packed pointer to the response body on success,
// or a negative HTTP-style error code (e.g. -403, -404, -413, -502).
pub fn get(url_ptr: i32, url_len: i32) -> i64 @Internal ! { NetIO, Alloc, FFI, Unsafe } {
    return http_get(url_ptr, url_len);
}

// HTTP POST with the given request body. Returns packed pointer to the
// response body on success, or a negative HTTP-style error code.
pub fn post(url_ptr: i32, url_len: i32, body_ptr: i32, body_len: i32) -> i64 @Internal ! { NetIO, Alloc, FFI, Unsafe } {
    return http_post(url_ptr, url_len, body_ptr, body_len);
}

// HTTP POST with caller-supplied request headers, for authenticated APIs.
// `hdrs` points at a newline-separated "Name: Value" blob (8 KB cap →
// -431 beyond it; a line without ':' → -400). Same grants and caps as
