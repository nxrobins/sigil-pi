// fetch.sigil — dispatched tool: HTTP GET a URL, return the response body.
// INPUT: the url. OUTPUT: response body bytes, or negative errno (-403 host not
// in the net grant, -404, -413 >5MB, -502 transport). MANIFEST: net grant is a
// deployment allowlist ({NET_ALLOWLIST}); empty allowlist = fetch denied.
// AUTHORSHIP: v14 via the workbench (greedy, oracle-verified against a fixture
// GET server, sample 1/2, FORGE-CLEAN + EXPECTED-MATCH).
#[ring(outer)] #[trusted] module tool;

extern "C" fn http_get(url: i32, url_len: i32) -> i64 ! { FFI, Unsafe };

pub fn tool_main(input_ptr: i32, input_len: i32) -> i64 ! { NetIO, Alloc, FFI, Unsafe } {
    return http_get(input_ptr, input_len);
}
